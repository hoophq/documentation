{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Hoop.dev - Automated Access and Data Protection",
  "colors": {
    "primary": "#333333",
    "light": "#B0B0B0",
    "dark": "#333333"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "decoration": "gradient"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 700
    },
    "body": {
      "family": "Inter"
    }
  },
  "favicon": "/favicon.svg",
  "redirects": [
    {
      "source": "/",
      "destination": "/admin",
      "conditions": {
        "host": "localhost:3000"
      }
    },
    {
      "source": "/setup/configuration/hoop-sidecar/get-started",
      "destination": "/install/cli"
    },
    {
      "source": "/clients/cli",
      "destination": "/install/cli"
    },
    {
      "source": "/setup/configuration/hoop-sidecar/deployment/container-images",
      "destination": "/install/container-images"
    },
    {
      "source": "/setup/configuration/hoop-sidecar/deployment/kubernetes",
      "destination": "/install/kubernetes"
    }
  ],
  "errors": {
    "404": {
      "redirect": true
    }
  },
